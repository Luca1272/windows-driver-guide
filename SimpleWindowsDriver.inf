;
; SimpleWindowsDriver.inf
;
; Non-PnP software driver. It creates its own control device in DriverEntry and
; is not bound to hardware, so install it with sc.exe (see README.md):
;
;     sc create SimpleWindowsDriver type= kernel binPath= C:\path\to\SimpleWindowsDriver.sys
;     sc start  SimpleWindowsDriver
;
; This INF is a reference for the service-install layout.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = SimpleWindowsDriver.cat
DriverVer   = 05/31/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12 ; %windir%\System32\drivers

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
SimpleWindowsDriver.sys = 1,,

;*****************************************
; Install Section (non-PnP service)
;*****************************************

[DefaultInstall.NT$ARCH$]
CopyFiles = File_Copy

[DefaultInstall.NT$ARCH$.Services]
AddService = SimpleWindowsDriver,0x00000000,SimpleWindowsDriver_Service_Inst

[File_Copy]
SimpleWindowsDriver.sys

; -------------- Service installation
[SimpleWindowsDriver_Service_Inst]
DisplayName    = %SimpleWindowsDriver.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\SimpleWindowsDriver.sys

[Strings]
ManufacturerName = "SimpleWindowsDriver (Educational)"
DiskName = "SimpleWindowsDriver Installation Disk"
SimpleWindowsDriver.SVCDESC = "SimpleWindowsDriver Service"
